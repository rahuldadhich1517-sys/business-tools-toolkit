{
  "name": "@rahul_dadhich15/business-tools-toolkit",
  "version": "0.1.0",
  "description": "Production-ready toolkit for generating business documents, digital business cards, email signatures, invoices, payment links, legal policies, resumes, cover letters, and signature capture.",
  "license": "MIT",
  "author": "Rahul Dadhich",
  "homepage": "https://github.com/rahuldadhich1517-sys/business-tools-toolkit#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/rahuldadhich1517-sys/business-tools-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/rahuldadhich1517-sys/business-tools-toolkit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "business-tools",
    "document-generator",
    "invoice",
    "invoice-pdf",
    "resume",
    "resume-pdf",
    "cover-letter",
    "vcard",
    "digital-business-card",
    "email-signature",
    "signature-pad",
    "paypal-link",
    "privacy-policy",
    "terms-of-service",
    "pdf"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run tests/e2e.test.ts"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^5.0.5"
  }
}
